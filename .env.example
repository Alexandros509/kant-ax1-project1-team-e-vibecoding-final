# Local educational demo. Leave provider and analytics keys empty for basic browsing.
LOCAL_DB_PATH=.local/onepiece-erd13-media-v3
APP_ORIGIN=http://127.0.0.1:3019
# Optional dedicated GA4 TEST property; no analytics DB table is created.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Kakao REST key and matching Client Secret: SERVER ONLY. New REST keys enable Secret by default.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Toss API individual payment-window TEST keys only. live_ keys are rejected.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Optional: auto (default) uses GA initial/history measurement; manual requires matching GA history settings.
NEXT_PUBLIC_GA_PAGEVIEW_MODE=
# Enable only for DebugView checks, leave empty for normal test-report collection.
NEXT_PUBLIC_GA_DEBUG_MODE=
